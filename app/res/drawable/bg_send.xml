<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/bg_send_disabled" />
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_send_pressed" />
            <corners android:radius="6.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_send_normal" />
            <corners android:radius="6.0dip" />
        </shape>
    </item>
</selector>